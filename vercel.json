{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "smartroad-ai": {
      "root": "smartroad-ai",
      "framework": "fastapi"
    },
    "smartroad-frontend": {
      "root": "smartroad-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/ai/(.*)",
      "destination": {
        "service": "smartroad-ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "smartroad-frontend"
      }
    }
  ]
}
